MONGO_URI=mongodb://127.0.0.1:27017/synapse-militaria?replicaSet=rs0&directConnection=true
# Para MongoDB Atlas: MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/synapse-militaria?retryWrites=true&w=majority
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Cuenta local creada únicamente al ejecutar npm run seed.
ADMIN_EMAIL=admin@synapse-militaria.cl
ADMIN_PASSWORD=admin123

# ─── Vercel (producción) ───
# En Vercel, configurar estas variables en el dashboard (Settings > Environment Variables):
#   MONGO_URI          → URI de MongoDB Atlas (nunca la URI local)
#   FRONTEND_ORIGINS   → https://tu-proyecto.vercel.app
#   ADMIN_EMAIL        → correo del administrador
#   ADMIN_PASSWORD     → contraseña segura (mínimo 12 caracteres, sin repetir la de desarrollo)
