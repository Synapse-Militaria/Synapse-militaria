MONGO_URI=mongodb://127.0.0.1:27017/synapse-militaria?replicaSet=rs0&directConnection=true
# Para MongoDB Atlas: MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/synapse-militaria?retryWrites=true&w=majority
# Para Neon PostgreSQL: NEON_URI=postgresql://USUARIO:CLAVE@HOST/neondb?sslmode=require
NEON_URI=
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Cuenta de administrador que npm run seed crea en PostgreSQL (Neon), compartida con producción.
# ADMIN_PASSWORD es obligatoria para que el seed cree la cuenta: debe tener 12 caracteres o más y no puede ser admin123.
ADMIN_EMAIL=admin@synapse-militaria.cl
ADMIN_PASSWORD=

# Clave para firmar los JWT (mínimo 32 caracteres, obligatoria en producción).
# Generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# ─── Vercel (producción) ───
# En Vercel, configurar estas variables en el dashboard (Settings > Environment Variables):
#   MONGO_URI          → URI de MongoDB Atlas (nunca la URI local)
#   NEON_URI           → URI de conexión a Neon PostgreSQL
#   JWT_SECRET         → clave aleatoria de al menos 32 caracteres (generarla con el comando de arriba)
#   FRONTEND_ORIGINS   → opcional (solo si frontend y API se alojan en dominios distintos)
